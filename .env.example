# Public canonical origin used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://razionlabs.com

# Where contact inquiries are delivered (server-side only, never exposed to the browser).
# Any HTTPS endpoint that accepts a JSON POST: Slack/Teams webhook, Zapier, Make, CRM intake, etc.
CONTACT_WEBHOOK_URL=

# Analytics (off by default). Set to "vercel" to enable cookieless Vercel Web Analytics
# and conversion events (CTA clicks, demo engagement, contact submissions). No personal data is sent.
# Also enable Web Analytics in the Vercel project dashboard.
NEXT_PUBLIC_ANALYTICS=
